# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database that the `contacts` collection lives in.
DB_NAME=heaven_furniture

# Port for the API server (the Vite dev server proxies /api here).
PORT=3001
